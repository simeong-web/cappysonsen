{
  "name": "capybara-club-cappys-onsen",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "HOST_ORIGIN=http://localhost:3000 pnpm build && serve dist -l 3001",
    "bench": "node scripts/bench.mjs && serve debug/dist -l 3002",
    "build": "node scripts/build.mjs",
    "test:conformance": "HOST_ORIGIN=http://localhost:3000 pnpm build && capybara-conformance-test ./dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint"
  },
  "dependencies": {
    "@mittell/capybara-club-sdk": "0.3.1",
    "pixi.js": "^8.19.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "oxlint": "^1.83.0",
    "playwright": "^1.63.0",
    "serve": "^14.2.6",
    "typescript": "^7.0.2",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@11.16.0"
}
